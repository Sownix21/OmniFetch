# Required
BOT_TOKEN=123456789:replace_with_your_botfather_token
ADMIN_ID=123456789

# Set this only when running telegram-bot-api in --local mode on this machine.
# API_ID/API_HASH belong to that separate service, never in this bot file.
# BOT_API_URL=http://127.0.0.1:8081

# Optional
GITHUB_TOKEN=
COOKIES_FILE=
MAX_UPLOAD_MB=49
MAX_DOWNLOAD_MB=500
MAX_PLAYLIST_ITEMS=10
MAX_CONCURRENT_DOWNLOADS=2
REQUEST_TIMEOUT=20
TRANSFER_TIMEOUT=180
MIN_FREE_DISK_MB=1024
LOG_LEVEL=INFO
