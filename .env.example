# Required
BOT_TOKEN=123456789:replace_with_your_botfather_token
ADMIN_ID=123456789

# Set this only when running telegram-bot-api in --local mode on this machine.
# API_ID/API_HASH belong to that separate service, never in this bot file.
# BOT_API_URL=http://127.0.0.1:18081

# Optional
GITHUB_TOKEN=
COOKIES_FILE=
# Optional site-specific Netscape cookie files, readable by the service user.
IG_COOKIES_FILE=
X_COOKIES_FILE=
# Optional Cobalt instance you host or have permission to use. Empty disables it.
COBALT_API_URL=
COBALT_API_KEY=
# Total on-disk download budget per job (MB). Defaults to file limit x item limit.
MAX_JOB_MB=5000
# Optional direct Google Play download credentials for apkeep.
# Use a dedicated, low-value Google account. TOKEN_TYPE is aas or auth.
GOOGLE_PLAY_EMAIL=
GOOGLE_PLAY_TOKEN=
GOOGLE_PLAY_TOKEN_TYPE=aas
GOOGLE_PLAY_ACCEPT_TOS=false
MAX_UPLOAD_MB=49
MAX_DOWNLOAD_MB=500
MAX_PLAYLIST_ITEMS=10
MAX_CONCURRENT_DOWNLOADS=2
REQUEST_TIMEOUT=20
TRANSFER_TIMEOUT=180
MIN_FREE_DISK_MB=1024
LOG_LEVEL=INFO
